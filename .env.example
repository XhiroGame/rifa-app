# =================================================================
# VARIABLES DE ENTORNO PARA GOOGLE SHEETS API
# =================================================================

# 1. ID de la Hoja de Cálculo de Google Sheets
# Se obtiene de la URL de tu hoja:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_SHEET_ID/edit
GOOGLE_SHEET_ID=tu_google_sheet_id_aqui

# 2. Correo electrónico de la Cuenta de Servicio (Service Account)
# Generado en Google Cloud Console > IAM & Admin > Service Accounts
# Ejemplo: mi-servicio-rifa@mi-proyecto-12345.iam.gserviceaccount.com
# NOTA: Debes compartir tu Google Sheet con este correo como 'Editor'.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-servicio@proyecto.iam.gserviceaccount.com

# 3. Clave privada de la Cuenta de Servicio (Private Key)
# Se encuentra dentro del archivo .json que descargas de Google Cloud.
# En variables de entorno, asegúrate de mantener los saltos de línea con \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...TU_CLAVE_AQUI...\n-----END PRIVATE KEY-----\n"

# 4. Nombre de la pestaña en la hoja de cálculo (por defecto: Boletas)
GOOGLE_SHEET_TAB_NAME=Boletas


# =================================================================
# SEGURIDAD Y PANEL DE ADMINISTRACIÓN (/admin)
# =================================================================
# Contraseña para acceder a la ruta protegida /admin y aprobar/rechazar pagos
ADMIN_PASSWORD=admin123


# =================================================================
# GEMINI API (EXTRACCIÓN AUTOMÁTICA DE DATOS DEL COMPROBANTE)
# =================================================================
# Obtén tu clave gratuita en: https://aistudio.google.com/
# Gemini analiza el comprobante (JPG/PNG) y extrae: monto total,
# fecha, hora y número de referencia/aprobación en formato JSON.
GEMINI_API_KEY=tu_gemini_api_key_aqui


# =================================================================
# GOOGLE DRIVE (ALMACENAMIENTO DE COMPROBANTES)
# =================================================================
# ID de la carpeta en Google Drive donde se guardarán las imágenes.
# Se obtiene de la URL de la carpeta: https://drive.google.com/drive/folders/ESTE_ES_EL_ID
# NOTA: Comparte la carpeta de Drive con el correo de la Cuenta de Servicio como 'Editor'.
# Si se deja vacío, se almacenará localmente en /public/uploads/comprobantes/.
GOOGLE_DRIVE_FOLDER_ID=id_de_carpeta_en_drive_aqui


# =================================================================
# PERSONALIZACIÓN DE LA RIFA
# =================================================================

NEXT_PUBLIC_RAFFLE_TITLE="Rifas e Inversiones La Calidosa"
NEXT_PUBLIC_RAFFLE_SUBTITLE="¡Elige tu número de la suerte del 000 al 999 y paga tu cuota mensual de \$100.000 COP!"
NEXT_PUBLIC_RAFFLE_PRIZE="Primer Premio: Carro 0 Km o \$70,000,000 COP"
NEXT_PUBLIC_MONTHLY_PRICE="\$100,000 COP / mes"
NEXT_PUBLIC_TICKET_PRICE="\$100,000 COP"
NEXT_PUBLIC_DRAW_DATE="20 de Diciembre de 2026"
NEXT_PUBLIC_LOTTERY_NAME="Lotería de Medellín (Últimas 3 cifras)"
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
